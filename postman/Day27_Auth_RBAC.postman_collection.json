            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blocked Manager Update\",\n  \"description\": \"This should fail because the manager does not own this project.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/projects/{{other_project_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{other_project_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('manager update other project is forbidden', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
